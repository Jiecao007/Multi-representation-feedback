# Copy to .env and set your own key locally. Never commit the populated file.
OPENAI_API_KEY=
# Optional overrides; these reflect the saved source defaults.
EVALUATION_MODEL=gpt-6-astra
TRANSFORMATION_MODEL=gpt-6-astra
TUTOR_MODEL=gpt-6-luna
FAST_DIALOGUE_EFFORT=low
DRAWING_PROFILE=fast
SIMULATED_STUDENT_MODEL=gpt-6-sol
